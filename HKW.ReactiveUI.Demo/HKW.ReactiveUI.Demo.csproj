<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>Enable</ImplicitUsings>
    <Nullable>Enable</Nullable>
    <RootNamespace>HKW.HKWReactiveUI.Demo</RootNamespace>
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference
      Include="..\HKW.ReactiveUI\HKW.ReactiveUI.csproj"
      OutputItemType="Analyzer"
      ReferenceOutputAssembly="true"
    />
    <PackageReference
      Include="HKW.SourceGeneratorUtils"
      Version="0.1.3"
      GeneratePathProperty="true"
    />
    <Analyzer Include="$(PkgHKW_SourceGeneratorUtils)\lib\netstandard2.0\*.dll" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="ReactiveUI" Version="24.2.0" />
  </ItemGroup>
</Project>
