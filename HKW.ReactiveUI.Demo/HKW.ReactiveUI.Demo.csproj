<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>Enable</ImplicitUsings>
    <Nullable>Enable</Nullable>
    <RootNamespace>HKW.HKWReactiveUI.Demo</RootNamespace>
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference
      Include="..\HKW.ReactiveUI\HKW.ReactiveUI.csproj"
      OutputItemType="Analyzer"
      ReferenceOutputAssembly="true"
    />
    <PackageReference
      Include="HKW.SourceGeneratorUtils"
      Version="0.1.1"
      GeneratePathProperty="true"
    />
    <Analyzer Include="$(PkgHKW_SourceGeneratorUtils)\lib\netstandard2.0\*.dll" />
    <WeaverFiles Include="$(SolutionDir)HKW.ReactiveUI.Fody\bin\$(Configuration)\netstandard2.0\HKW.ReactiveUI.Fody.dll" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Fody" Version="6.9.3" PrivateAssets="all" />
    <PackageReference Include="ReactiveUI" Version="24.1.0" />
  </ItemGroup>
</Project>
