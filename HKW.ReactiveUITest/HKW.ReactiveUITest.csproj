<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>HKW.HKWReactiveUITest</RootNamespace>
    <PathMap>$(SolutionDir)=$(MSBuildProjectName.Replace(" ", "_"))/</PathMap>
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <StartupObject>HKW.HKWReactiveUITest.Program</StartupObject>
    <UseAppHost>false</UseAppHost>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MSTest" Version="4.4.0" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Microsoft.VisualStudio.TestTools.UnitTesting" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference
      Include="HKW.SourceGeneratorUtils"
      Version="0.1.3"
      GeneratePathProperty="true"
    />
    <Analyzer Include="$(PkgHKW_SourceGeneratorUtils)\lib\netstandard2.0\*.dll" />
    <ProjectReference
      Include="..\HKW.ReactiveUI\HKW.ReactiveUI.csproj"
      OutputItemType="Analyzer"
      ReferenceOutputAssembly="true"
    />
    <WeaverFiles Include="$(SolutionDir)HKW.ReactiveUI.Fody\bin\$(Configuration)\netstandard2.0\HKW.ReactiveUI.Fody.dll" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Fody" Version="6.9.3" PrivateAssets="all" />
    <PackageReference Include="ReactiveUI" Version="24.2.0" />
  </ItemGroup>
</Project>
